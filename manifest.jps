jpsType: install
jpsVersion: '1.7.3'
name: Magento PHP Box (AppServer only)
description:
  short: Single nginx/php-fpm node for Magento 2. DB, sessions Redis and
    OpenSearch live in a separate services environment. All box
    configuration comes from the "Magento PHP Box" add-on, which re-applies
    itself after every container redeploy.

baseUrl: https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/main/

settings:
  fields:
  - caption: "PHP Version"
    type: list
    values:
        1.30.6-php-8.4.27-almalinux-9 : 8.4.27
    required: true
    name: PHP_VERSION
    value: 1.30.6-php-8.4.27-almalinux-9
  - caption: Services env - MariaDB internal IP
    type: string
    name: DB_HOST
    required: true
  - caption: Services env - Redis (sessions) internal IP
    type: string
    name: REDIS_HOST
    required: true
  - caption: Services env - OpenSearch internal IP
    type: string
    name: ES_HOST
    required: true
  - caption: Alert / backup email
    type: string
    name: BACKUP_EMAIL
    required: true
  - caption: Monitor SSH public key (optional)
    type: text
    name: MONITOR_SSH_KEY
    required: false
  - caption: Config repo ref
    type: string
    name: REPO_REF
    value: main
    required: true

skipNodeEmails: true

nodes:
# Pulled straight from Docker Hub: nodeType nginxphp-dockerized + tag silently
# falls back to the provider's default stack when its catalog lacks the tag.
- nodeType: docker
  image: jelastic/nginxphp:${settings.PHP_VERSION}
  count: 1
  cloudlets: 74
  extip: 1
  nodeGroup: cp
  displayName: AppServer
  volumes:
    - /var/www/webroot/ROOT
    - /var/www/webroot/nfs
  env:
    PHPFPM_MAX_CHILDREN: 1000
    REDIS_ENABLED: 1

onInstall:
  - checkPhpVersion
  - install:
      jps: ${baseUrl}addons/phpbox-addon.jps
      nodeGroup: cp
      settings:
        DB_HOST: ${settings.DB_HOST}
        REDIS_HOST: ${settings.REDIS_HOST}
        ES_HOST: ${settings.ES_HOST}
        BACKUP_EMAIL: ${settings.BACKUP_EMAIL}
        MONITOR_SSH_KEY: ${settings.MONITOR_SSH_KEY:}
        REPO_REF: ${settings.REPO_REF}

actions:
  checkPhpVersion:
  - log: Check AppServer PHP version
  - cmd [cp]: |-
      want=$(echo '${settings.PHP_VERSION}' | sed -E 's/.*-php-([0-9.]+)-.*/\1/')
      have=$(php -r 'echo PHP_VERSION;')
      echo "AppServer PHP $have, expected $want"
      [ "$have" = "$want" ] || exit 1
    user: root

success:
  text: |
    ## AppServer created

    Configuration, credentials and the self-healing bits are managed by the
    **Magento PHP Box** add-on (Add-ons tab on the AppServer layer). Use its
    **Show credentials** button for passwords.

    Next: bind the domain, deploy code to `/var/www/webroot/ROOT`, install the
    Let's Encrypt add-on on this layer (webroot `/var/www/webroot/ROOT/pub`).
