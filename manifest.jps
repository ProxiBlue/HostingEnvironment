jpsType: install
jpsVersion: '1.7.3'
name: ProxiBlue PHP Box (AppServer only)
description:
  short: Single nginx/php-fpm node for a Magento 2 or Drupal site. DB (and
    optionally Redis / OpenSearch) live in a separate services environment,
    picked from a dropdown. All box configuration comes from the "ProxiBlue
    PHP Box" add-on, which re-applies itself after every container redeploy.

baseUrl: https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/main/

settings:
  fields:
  - caption: "PHP Version"
    type: list
    values:
        1.30.6-php-8.4.27-almalinux-9 : 8.4.27
    required: true
    name: PHP_VERSION
    value: 1.30.6-php-8.4.27-almalinux-9
  - caption: Site profile
    type: list
    name: SITE_PROFILE
    values:
      magento: Magento 2 / Mage-OS
      drupal: Drupal
    value: magento
    required: true
    showIf:
      drupal:
        - caption: NFS mounts (drupal)
          type: text
          name: MOUNTS_DRUPAL
          required: false
          value: |-
            /data /var/www/webroot/ROOT/web/sites/default/files
            ehop-uat-512365:/backups /BACKUPS
            ehop-uat-512365:/data /UAT_FILES
          description: "One per line: <path on services storage node> <path on this box>; other env: <envName>:/path"
      magento:
        - caption: NFS mounts (magento)
          type: text
          name: MOUNTS_MAGENTO
          required: false
          value: |-
            /data /var/www/webroot/nfs
          description: "One per line: <path on services storage node> <path on this box>; other env: <envName>:/path"
  - caption: Services environment
    type: envlist
    name: SERVICES_ENV
    valueField: shortdomain
    disableInactive: true
    required: true
    description: Environment holding the DB node (layer sqldb). Redis
      (nosqldb) and OpenSearch (es) are picked up too if present.
  - caption: Document root (blank = profile default)
    type: string
    name: DOCROOT
    required: false
    description: "magento: /var/www/webroot/ROOT/pub, drupal: /var/www/webroot/ROOT/web"
  - caption: Behind Cloudflare (proxied DNS)
    type: checkbox
    name: CLOUDFLARE
    value: false
    description: Trust CF-Connecting-IP from Cloudflare's ranges so logs and
      fail2ban see the visitor, not the edge. Origin certificate is picked up
      from <nfs mount>/ssl/jelastic.chain + jelastic.key.
  - caption: Alert / backup email
    type: string
    name: BACKUP_EMAIL
    required: true
  - caption: Monitor SSH public key (optional)
    type: text
    name: MONITOR_SSH_KEY
    required: false
  - caption: Config repo ref
    type: string
    name: REPO_REF
    value: main
    required: true

skipNodeEmails: true

nodes:
# Pulled straight from Docker Hub: nodeType nginxphp-dockerized + tag silently
# falls back to the provider's default stack when its catalog lacks the tag.
- nodeType: docker
  image: jelastic/nginxphp:${settings.PHP_VERSION}
  count: 1
  cloudlets: 74
  extip: 1
  nodeGroup: cp
  displayName: AppServer
  volumes:
    - /var/www/webroot/ROOT
    - /var/www/webroot/nfs
  env:
    PHPFPM_MAX_CHILDREN: 1000
    REDIS_ENABLED: 1

onInstall:
  - checkPhpVersion
  - install:
      jps: ${baseUrl}addons/phpbox-addon.jps
      nodeGroup: cp
      settings:
        SITE_PROFILE: ${settings.SITE_PROFILE}
        SERVICES_ENV: ${settings.SERVICES_ENV}
        DOCROOT: ${settings.DOCROOT:}
        MOUNTS_DRUPAL: ${settings.MOUNTS_DRUPAL:}
        MOUNTS_MAGENTO: ${settings.MOUNTS_MAGENTO:}
        CLOUDFLARE: ${settings.CLOUDFLARE:false}
        BACKUP_EMAIL: ${settings.BACKUP_EMAIL}
        MONITOR_SSH_KEY: ${settings.MONITOR_SSH_KEY:}
        REPO_REF: ${settings.REPO_REF}

actions:
  checkPhpVersion:
  - log: Check AppServer PHP version
  - cmd [cp]: |-
      want=$(echo '${settings.PHP_VERSION}' | sed -E 's/.*-php-([0-9.]+)-.*/\1/')
      have=$(php -r 'echo PHP_VERSION;')
      echo "AppServer PHP $have, expected $want"
      [ "$have" = "$want" ] || exit 1
    user: root

success:
  text: |
    ## AppServer created (${settings.SITE_PROFILE})

    Configuration, credentials and the self-healing bits are managed by the
    **ProxiBlue PHP Box** add-on (Add-ons tab on the AppServer layer). Use its
    **Show credentials** button for passwords and **Show services IPs** for
    the DB / Redis / OpenSearch addresses it resolved from `${settings.SERVICES_ENV}`.

    Terminal: `su -` on the AppServer, then `phpbox status` / `phpbox creds`.

    Next: deploy code to `/var/www/webroot/ROOT`, bind the domain, install
    Let's Encrypt via Import → URL → `.../addons/letsencrypt-docker.jps`
    (the Marketplace copy hides itself from docker-type nodes).
