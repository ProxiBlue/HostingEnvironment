# n8n reverse proxy - generated from configs/n8n/nginx-n8n.conf.template
# Edit /etc/nginx/conf.d/n8n.conf to adjust the IP allowlist, then:
#   nginx -t && systemctl reload nginx

server {
    listen __N8N_PORT__;
    listen [::]:__N8N_PORT__;
    # Catch-all server_name: this is the only vhost on __N8N_PORT__, so routing
    # is by port, not Host header. Using '_' instead of the n8n subdomain hides
    # it from the Jelastic LE addon's vhost scan, which would otherwise try to
    # issue a cert for n8n.<env.domain> and fail (no DNS for the subdomain).
    # When you put SSL on n8n later, set this to the real subdomain.
    server_name _;

    # Serve nothing for non-allowlisted source IPs.
__ALLOW_BLOCK__

    # WebSocket + SSE: n8n pushes execution updates over WS.
    proxy_http_version 1.1;
    proxy_set_header   Upgrade           $http_upgrade;
    proxy_set_header   Connection        "upgrade";
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:5678;
    }
}
