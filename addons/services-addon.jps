type: update
jpsVersion: '1.7.3'
id: proxiblue-services
name: ProxiBlue Services
description:
  short: Monitoring (n8n) and optional hardening / self-healing for a shared
    services environment (DB, Redis sessions, OpenSearch). Installs on the
    env's nginx node and watches the PHP box over SSH. Nothing on the data
    nodes is touched unless the matching option is ticked.

baseUrl: https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/main/

# Attaches to the nginx node (layer cp) of the services env; the data layers
# (sqldb, nosqldb, es) are provisioned from here by node group.
targetNodes:
  nodeGroup: cp

settings:
  main:
    fields:
    - caption: PHP box environment
      type: envlist
      name: PHPBOX_ENV
      valueField: shortdomain
      disableInactive: false
      required: false
      description: Environment whose AppServer (layer cp) serves the site.
        Leave empty until it exists; set later via "Configure".
    - caption: Alert email
      type: string
      name: ALERT_EMAIL
      required: true
    - caption: Magento cron check - DB user (blank = no cron check)
      type: string
      name: DB_USER
      required: false
      description: Only used by the Magento cron health check (reads
        cron_schedule from this env's DB). Drupal sites leave both blank.
    - caption: Magento cron check - DB password
      type: string
      inputType: password
      name: DB_PASS
      required: false
    - caption: Gemini API Key (n8n monitor workflow)
      type: string
      name: GEMINI_API_KEY
      required: false
    - caption: Monitor Workflow Schedule
      type: list
      values:
          "0 */4 * * *": "Every 4 hours (default)"
          "0 */6 * * *": "Every 6 hours"
          "0 2 * * *": "Daily at 02:00"
      required: true
      name: MONITOR_SCHEDULE
      value: "0 */4 * * *"
    - caption: n8n UI IP Allowlist
      type: text
      name: N8N_ALLOWED_IPS
      required: true
      description: "Comma-separated CIDRs allowed to reach the n8n UI (e.g. '203.0.113.4/32, 198.51.100.0/24')."
    - caption: n8n UI Port
      type: list
      values:
          "8443": "8443 (default)"
          "8080": "8080"
      required: true
      name: N8N_PORT
      value: "8443"
    - caption: Harden data nodes (DB my.cnf + restart, Redis/OpenSearch config, health-check crons)
      type: checkbox
      name: HARDEN_DATA
      value: false
      description: "Live env: leave OFF. Appending the my.cnf block restarts the DB."
    - caption: Config repo ref
      type: string
      name: REPO_REF
      value: main
      required: true
  addNodes:
    fields:
    - caption: Add Redis (sessions) node, layer nosqldb
      type: checkbox
      name: ADD_REDIS
      value: false
    - caption: Add OpenSearch node, layer es
      type: checkbox
      name: ADD_ES
      value: false
    - caption: OpenSearch version
      type: list
      values:
          2.19.2-openjdk-11.0.25-almalinux-9 : 2.19.2 (Magento <= 2.4.8)
          3.6.0-openjdk-21.0.2-almalinux-9 : 3.6.0 (Magento 2.4.9+)
      required: true
      name: OS_VERSION
      value: 2.19.2-openjdk-11.0.25-almalinux-9

onInstall:
  - if ('${settings.HARDEN_DATA:false}' == 'true'):
      provisionData
  - provisionCp

# The nginx node is a dockerized stack too; re-provision if it is redeployed.
onAfterRedeployContainer [cp]:
  - provisionCp

onUninstall:
  - cmd [cp]: |-
      systemctl disable --now n8n 2>/dev/null || true
      sed -i '/check_magento_cron.sh/d' /var/spool/cron/root 2>/dev/null || true
    user: root

buttons:
  - caption: Configure
    settings: main
    loadingText: Applying...
    action: provisionCp
    successText: Settings applied to the nginx/n8n node.
  - caption: Add Redis / OpenSearch nodes
    settings: addNodes
    loadingText: Adding nodes...
    action: addDataNodes
    successText: Done. Run "Harden data nodes" to provision the new node(s).
  - caption: Harden data nodes
    confirmText: Apply hardening + health-check crons to DB / Redis / OpenSearch nodes? The DB restarts if its my.cnf block is missing.
    loadingText: Provisioning...
    action: provisionData
    successText: Data nodes provisioned. Log at /var/log/services-provision.log on each node.
  - caption: Show monitor SSH key
    loadingText: Reading...
    action: showMonitorKey
  - caption: Update n8n
    confirmText: Update the n8n npm package and restart the service?
    loadingText: Updating n8n...
    action: updateN8n
    successText: n8n updated and restarted.

actions:
  # Which layers exist in this env.
  detectNodes:
    script: |
      var r = api.env.control.GetEnvInfo('${env.envName}', session);
      if (r.result != 0) return r;
      var g = {};
      for (var i = 0; i < r.nodes.length; i++) g[r.nodes[i].nodeGroup] = true;
      return { result: 0, hasDb: !!g.sqldb, hasRedis: !!g.nosqldb, hasEs: !!g.es };

  # Internal IP of the PHP box's AppServer (layer cp) in the selected env.
  resolvePhpBox:
    script: |
      var name = '${settings.PHPBOX_ENV:}';
      if (!name) return { result: 0, phpboxIp: '' };
      var r = api.env.control.GetEnvInfo(name, session);
      if (r.result != 0) return r;
      var ip = '';
      for (var i = 0; i < r.nodes.length; i++) {
        var n = r.nodes[i];
        if (n.nodeGroup == 'cp' && (!ip || n.ismaster)) ip = n.intIP;
      }
      return { result: 0, phpboxIp: ip };

  addDataNodes:
    - detectNodes
    - if ('${settings.ADD_REDIS:false}' == 'true' && '${response.hasRedis}' != 'true'):
        - log: adding Redis (sessions) node, layer nosqldb
        - addNodes:
            nodeType: redis
            nodeGroup: nosqldb
            displayName: Redis for Sessions
            fixedCloudlets: 2
            flexibleCloudlets: 28
    - detectNodes
    - if ('${settings.ADD_ES:false}' == 'true' && '${response.hasEs}' != 'true'):
        - log: adding OpenSearch node, layer es
        - addNodes:
            nodeType: docker
            dockerName: jelastic/opensearch:${settings.OS_VERSION}
            nodeGroup: es
            displayName: OpenSearch
            fixedCloudlets: 4
            flexibleCloudlets: 28
            dockerEnvVars:
              DISABLE_INSTALL_DEMO_CONFIG: "true"
              OPENSEARCH_JAVA_OPTS: "-Xms4g -Xmx4g"
            dockerEntryPoint: ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

  provisionData:
    - detectNodes
    - if ('${response.hasDb}' == 'true'):
        provisionDb
    - detectNodes
    - if ('${response.hasRedis}' == 'true'):
        provisionRedis
    - detectNodes
    - if ('${response.hasEs}' == 'true'):
        provisionEs

  provisionDb:
    - cmd [sqldb]: |-
        export REPO_REF='${settings.REPO_REF:main}'
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/scripts/provision-services-data.sh" -o /root/provision-services-data.sh
        chmod +x /root/provision-services-data.sh
        bash /root/provision-services-data.sh db 2>&1 | tee -a /var/log/run.log
      user: root
      sayYes: true

  provisionRedis:
    - cmd [nosqldb]: |-
        export REPO_REF='${settings.REPO_REF:main}'
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/scripts/provision-services-data.sh" -o /root/provision-services-data.sh
        chmod +x /root/provision-services-data.sh
        bash /root/provision-services-data.sh redis 2>&1 | tee -a /var/log/run.log
      user: root
      sayYes: true

  provisionEs:
    - cmd [es]: |-
        export REPO_REF='${settings.REPO_REF:main}'
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/scripts/provision-services-data.sh" -o /root/provision-services-data.sh
        chmod +x /root/provision-services-data.sh
        bash /root/provision-services-data.sh es 2>&1 | tee -a /var/log/run.log
      user: root
      sayYes: true

  provisionCp:
    - resolvePhpBox
    - cmd [cp]: |-
        export PHPBOX_HOST='${response.phpboxIp}'
        export DB_HOST='${nodes.sqldb.master.intIP}'
        export REDIS_HOST='${nodes.nosqldb.master.intIP:}'
        export ES_HOST='${nodes.es.first.intIP:}'
        export DB_USER='${settings.DB_USER:}'
        export DB_PASS='${settings.DB_PASS:}'
        export ALERT_EMAIL='${settings.ALERT_EMAIL:}'
        export GEMINI_API_KEY='${settings.GEMINI_API_KEY:}'
        export MONITOR_SCHEDULE='${settings.MONITOR_SCHEDULE:0 */4 * * *}'
        export N8N_DOMAIN='n8n.${env.domain}'
        export N8N_PUBLIC_PORT='${settings.N8N_PORT:8443}'
        export N8N_ALLOWED_IPS='${settings.N8N_ALLOWED_IPS:}'
        export REPO_REF='${settings.REPO_REF:main}'
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/scripts/provision-services-cp.sh" -o /root/provision-services-cp.sh
        chmod +x /root/provision-services-cp.sh
        set -o pipefail
        bash /root/provision-services-cp.sh 2>&1 | tee -a /var/log/run.log
      user: root
      sayYes: true

  showMonitorKey:
    - cmd [cp]: cat /var/lib/n8n/.ssh/id_ed25519.pub
      user: root
    - return:
        type: success
        message: |
          Paste into the PHP box add-on ("Authorize monitor key"):

          ```
          ${response.responses.out}
          ```

  updateN8n:
    - cmd [cp]: |-
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/configs/n8n/update_n8n.sh" | bash
      user: root

success:
  text: |
    ## ProxiBlue Services add-on installed

    * **Nodes**: DB `${nodes.sqldb.master.intIP:}`, Redis sessions
      `${nodes.nosqldb.master.intIP:}`, OpenSearch `${nodes.es.first.intIP:}`.
      The PHP box add-on resolves these itself from the env dropdown.
    * **Monitor SSH key**: **Show monitor SSH key**, then **Authorize
      monitor key** on the PHP box add-on.
    * **n8n**: http://n8n.${env.domain}:${settings.N8N_PORT}/ (allowlisted
      IPs only; create the owner account on first visit, then activate the
      `Server Monitor` workflow). Env file `/etc/n8n/n8n.env`.
    * Data nodes untouched unless "Harden data nodes" was ticked / pressed.
    * Logs: `/var/log/services-provision.log` on each node.
