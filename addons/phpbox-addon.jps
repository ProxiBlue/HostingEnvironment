type: update
jpsVersion: '1.7.3'
id: proxiblue-phpbox
name: ProxiBlue PHP Box
description:
  short: Configures the AppServer (nginx/php-fpm) node for a Magento or Drupal
    site whose DB (and optionally Redis / OpenSearch) live in another
    environment, and re-applies itself after every container redeploy.

baseUrl: https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/main/

targetNodes:
  nodeGroup: cp

settings:
  main:
    fields:
    - caption: Site profile
      type: list
      name: SITE_PROFILE
      values:
        magento: Magento 2 / Mage-OS
        drupal: Drupal
      value: magento
      required: true
      showIf:
        drupal:
          - caption: NFS mounts (drupal)
            type: text
            name: MOUNTS_DRUPAL
            required: false
            value: |-
              /data /var/www/webroot/ROOT/web/sites/default/files
              ehop-uat-512365:/backups /BACKUPS
              ehop-uat-512365:/data /UAT_FILES
            description: "One per line: <path on services storage node> <path on this box>; other env: <envName>:/path. Existing mount points are left alone."
        magento:
          - caption: NFS mounts (magento)
            type: text
            name: MOUNTS_MAGENTO
            required: false
            value: |-
              /data /var/www/webroot/ROOT/pub/media
            description: "One per line: <path on services storage node> <path on this box>; other env: <envName>:/path. Existing mount points are left alone."
    - caption: Services environment
      type: envlist
      name: SERVICES_ENV
      valueField: shortdomain
      disableInactive: true
      required: true
      description: Environment holding the DB node (layer sqldb). Redis
        (nosqldb) and OpenSearch (es) are picked up too if that env has them.
    - caption: Document root (blank = profile default)
      type: string
      name: DOCROOT
      required: false
      description: "magento: /var/www/webroot/ROOT/pub, drupal: /var/www/webroot/ROOT/web"
    - caption: Alert / backup email
      type: string
      name: BACKUP_EMAIL
      required: true
    - caption: Monitor SSH public key
      type: text
      name: MONITOR_SSH_KEY
      required: false
      description: Public key printed by the Services add-on. Lets the services
        node's n8n pull a health snapshot from this box over SSH. Can be added
        later via the "Authorize monitor key" button (or "phpbox authorize-key" in the terminal).
    - caption: Config repo ref
      type: string
      name: REPO_REF
      value: main
      required: true
      description: Git ref of ProxiBlue/HostingEnvironment to pull configs
        from. Pin a commit sha to avoid raw.githubusercontent cache lag.
  monitorKey:
    fields:
    - caption: Monitor SSH public key
      type: text
      name: MONITOR_SSH_KEY
      required: true

onInstall:
  - provision
  - mounts

# GUI "Redeploy Containers" (PHP tag change) wipes everything outside the
# volumes and redeploy.conf; run the provisioner again on the fresh image.
# Mount points are env config and survive, mounts is idempotent anyway.
onAfterRedeployContainer [cp]:
  - provision
  - mounts

onUninstall:
  - cmd [cp]: |-
      systemctl disable --now monit fail2ban 2>/dev/null || true
      rm -f /etc/sudoers.d/phpbox-monitor
      sed -i '/fail2banUpdate.sh/d' /var/spool/cron/root 2>/dev/null || true
    user: root

buttons:
  - caption: Re-apply configuration
    confirmText: Re-run the provisioner (configs, packages, crons) on the AppServer?
    loadingText: Provisioning...
    action: provision
    successText: AppServer re-provisioned. Log at /var/log/phpbox-provision.log.
  - caption: Update fail2ban filters
    loadingText: Updating...
    action: updateFail2ban
    successText: fail2ban filters refreshed from the repo and service restarted.
  - caption: Authorize monitor key
    settings: monitorKey
    loadingText: Adding key...
    action: authorizeMonitorKey
    successText: Key added to nginx's authorized_keys on the AppServer.
  - caption: Apply mounts
    confirmText: Create any NFS mount points from the add-on's mounts setting that do not exist yet?
    loadingText: Mounting...
    action: showMounts
  - caption: Show services IPs
    loadingText: Resolving...
    action: showServices
  - caption: Show credentials
    loadingText: Reading...
    action: showCredentials

actions:
  # Internal IPs of the DB / Redis / OpenSearch nodes in the selected services
  # env. Master node of each layer; blank when the layer does not exist.
  resolveServices:
    script: |
      var name = '${settings.SERVICES_ENV:}';
      if (!name) return { result: 0, dbIp: '', redisIp: '', esIp: '', note: 'no services env selected' };
      var r = api.env.control.GetEnvInfo(name, session);
      if (r.result != 0) return r;
      var ip = { sqldb: '', nosqldb: '', es: '' };
      for (var i = 0; i < r.nodes.length; i++) {
        var n = r.nodes[i];
        if (!(n.nodeGroup in ip)) continue;
        if (!ip[n.nodeGroup] || n.ismaster) ip[n.nodeGroup] = n.intIP;
      }
      return { result: 0, dbIp: ip.sqldb, redisIp: ip.nosqldb, esIp: ip.es, note: name };

  provision:
    - resolveServices
    - cmd [cp]: |-
        export SITE_PROFILE='${settings.SITE_PROFILE:magento}'
        export DOCROOT='${settings.DOCROOT:}'
        export DB_HOST='${response.dbIp}'
        export REDIS_HOST='${response.redisIp}'
        export ES_HOST='${response.esIp}'
        export BACKUP_EMAIL='${settings.BACKUP_EMAIL:}'
        export MONITOR_SSH_KEY='${settings.MONITOR_SSH_KEY:}'
        export MOUNTS_DRUPAL='${settings.MOUNTS_DRUPAL:}'
        export MOUNTS_MAGENTO='${settings.MOUNTS_MAGENTO:}'
        export REPO_REF='${settings.REPO_REF:main}'
        curl -fsSL "https://raw.githubusercontent.com/ProxiBlue/HostingEnvironment/${settings.REPO_REF:main}/scripts/provision-cp.sh" -o /root/provision-cp.sh
        chmod +x /root/provision-cp.sh
        set -o pipefail
        bash /root/provision-cp.sh 2>&1 | tee -a /var/log/run.log
      user: root
      sayYes: true

  # NFS mount points on the cp layer from the services env's storage node.
  # "src dst" per line (also ; or , separated). Skips paths already mounted.
  mounts:
    script: |
      // Lines: "<src> <dst>". src = path on the services env's storage node,
      // or "<otherEnv>:<path>" for a storage node in another env (e.g. UAT).
      // The list lives in /etc/phpbox-mounts.txt on the box (written by
      // provision-cp.sh from the profile's setting; kept across redeploys;
      // editable by hand, then "Apply mounts" / phpbox mounts).
      var envName = '${env.envName}', svc = '${settings.SERVICES_ENV:}';
      var f = api.env.file.Read(envName, session, '/etc/phpbox-mounts.txt', null, 'cp');
      if (f.result != 0) return { result: 0, out: 'no /etc/phpbox-mounts.txt on the box (' + f.error + ')' };
      var raw = f.body || '';
      var items = String(raw).split(/[\r\n;,]+/), wanted = [], i;
      for (i = 0; i < items.length; i++) {
        var line = items[i].replace(/^\s+|\s+$/g, '');
        if (!line || line.charAt(0) == '#') continue;
        var p = line.split(/\s+/);
        if (p.length < 2 || p[1].charAt(0) != '/') continue;
        var m = p[0].match(/^([^:\/]+):(\/.*)$/);
        if (m) wanted.push({ env: m[1], src: m[2], dst: p[1] });
        else if (p[0].charAt(0) == '/') wanted.push({ env: svc, src: p[0], dst: p[1] });
      }
      if (!wanted.length) return { result: 0, out: 'no mounts configured' };
      var storage = {};
      function storageNode(e) {
        if (!e) return null;
        if (storage[e] !== undefined) return storage[e];
        var r = api.env.control.GetEnvInfo(e, session);
        if (r.result != 0) { storage[e] = null; return null; }
        var st = null;
        for (var k = 0; k < r.nodes.length; k++) {
          var n = r.nodes[k];
          if (n.nodeGroup == 'storage' && (!st || n.ismaster)) st = n;
        }
        storage[e] = st;
        return st;
      }
      var ex = api.env.file.GetMountPoints(envName, session, null, 'cp');
      if (ex.result != 0) return ex;
      var have = {}, arr = ex.array || [];
      for (i = 0; i < arr.length; i++) have[arr[i].path] = true;
      var out = [];
      for (i = 0; i < wanted.length; i++) {
        var w = wanted[i];
        if (have[w.dst]) { out.push('exists: ' + w.dst); continue; }
        var st = storageNode(w.env);
        if (!st) { out.push('SKIPPED ' + w.dst + ': no storage node in env ' + w.env); continue; }
        var a = api.env.file.AddMountPointByGroup(envName, session, 'cp', w.dst, 'nfs', st.intIP, w.src, st.id, '', false, 'IP');
        if (a.result != 0) return a;
        out.push('mounted ' + w.env + ':' + w.src + ' -> ' + w.dst);
      }
      return { result: 0, out: out.join('; ') };

  showMounts:
    - mounts
    - return:
        type: success
        message: ${response.out}

  updateFail2ban:
    - cmd [cp]: bash /root/fail2banUpdate.sh
      user: root

  authorizeMonitorKey:
    - cmd [cp]: |-
        ak=/var/lib/nginx/.ssh/authorized_keys
        install -d -m 0700 -o nginx -g nginx /var/lib/nginx/.ssh
        touch "$ak"; chown nginx:nginx "$ak"; chmod 0600 "$ak"
        key='${settings.MONITOR_SSH_KEY}'
        grep -qF -- "$key" "$ak" || echo "$key" >> "$ak"
      user: root

  showServices:
    - resolveServices
    - return:
        type: success
        message: |
          Services env `${response.note}`: DB `${response.dbIp}`, Redis
          `${response.redisIp}`, OpenSearch `${response.esIp}`
          (blank = that layer does not exist there).

  showCredentials:
    - cmd [cp]: |-
        cat /root/phpbox-credentials.txt
        echo
        cat /etc/phpbox.env
        echo
        echo "Monit: http://$(hostname -I | awk '{print $1}'):2812  user admin"
        echo "GoAccess: BASE_URL/site_report  user stats"
      user: root
    - return:
        type: success
        message: |
          ```
          ${response.responses.out}
          ```

success:
  text: |
    ## ProxiBlue PHP Box add-on installed (${settings.SITE_PROFILE})

    * Terminal: `su -` on the AppServer then `phpbox status | creds | env |
      reapply | fail2ban-update | authorize-key | log`.
    * Credentials: `phpbox creds` (or the **Show credentials** button).
    * Services env `${settings.SERVICES_ENV}`: hosts entries `DB_MASTER`
      (+ `RD_MASTER` / `ES_MASTER` where those layers exist). **Show services
      IPs** lists them. Local cache Redis on socket `/tmp/redis.sock`.
    * PHP update: **Redeploy Containers** on the AppServer, pick the new tag.
      The add-on re-provisions automatically afterwards.
    * SSL: install the Let's Encrypt add-on on this layer (webroot = the
      document root).
    * Log: `/var/log/phpbox-provision.log`
